<odoo>
    <data noupdate="0">
        <record id="hr_attendance_customization" model="ir.ui.view">
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='worked_hours']" position="after">
                    <field name="target_hours" widget="float_time" optional="show"/>
                    <field name="late_hours" widget="float_time" optional="show"/>
                    <field name="late_count" optional="show"/>

                    <field name="early_leave_hours" widget="float_time" optional="show"/>
                    <field name="early_leave_count" optional="show"/>

                    <field name="ro_overtime_morning_hours" widget="float_time" optional="show"/>
                    <field name="ro_overtime_night_hours" widget="float_time" optional="show"/>
                    <field name="ro_overtime_hours" widget="float_time" optional="show"/>
                    <field name="overtime_count" optional="show"/>

                    <field name="approve_overtime" optional="show"/>
                    <field name="remove_late" optional="show"/>
                    <field name="remove_early" optional="show"/>
                    <field name="is_weekend" optional="show"/>
                    <field name="is_holiday" optional="show"/>
                    <field name="is_absence" optional="show" readonly="1"/>
                </xpath>
            </field>
        </record>
        <record id="hr_attendance_customization_form" model="ir.ui.view">
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='check_out']" position="after">
                    <field name="is_absence" optional="show" groups="base.group_system"/>
                </xpath>
            </field>
        </record>

        <record id="hr_attendance_search_customization" model="ir.ui.view">
            <field name="model">hr.attendance</field>
            <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='groupby_check_out']" position="after">
                    <filter string="Late Count" name="groupby_late_count" context="{'group_by': 'late_count'}"/>
                </xpath>
            </field>
        </record>
        <odoo>
            <record id="action_approve_overtime" model="ir.actions.server">
                <field name="name">Approve Overtime</field>
                <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
                <field name="state">code</field>
                <field name="code">records.action_approve_overtime()</field>
            </record>
            <record id="action_remove_late" model="ir.actions.server">
                <field name="name">Remove Late</field>
                <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
                <field name="state">code</field>
                <field name="code">records.action_remove_late()</field>
            </record><record id="action_remove_early" model="ir.actions.server">
                <field name="name">Remove Early</field>
                <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
                <field name="state">code</field>
                <field name="code">records.action_remove_early()</field>
            </record>
        </odoo>
    </data>
</odoo>
