<odoo>
  <data noupdate="0">
    <record id="resource_calendare_customization" model="ir.ui.view">
      <field name="model">resource.calendar</field>
      <field name="inherit_id" ref="resource.resource_calendar_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='tz_offset']" position="after">
            <field name="allowed_late" widget="float_time"/>
            <field name="late_deduct" widget="float_time"/>
          </xpath>
      </field>
    </record>

  </data>
</odoo>
