<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <data noupdate="1">

      <!-- sequance -->
      <record id="sequence_emp_registeration_form" model="ir.sequence">
        <field name="name">Emp Registeration</field>
        <field name="code">emp.registeration</field>
        <field name="active">TRUE</field>
        <field name="padding">5</field>
        <field name="number_next">10000001</field>
        <field name="number_increment">1</field>
      </record>

        <record id="work_entry_type_attendance_sheet_weekend"
                model="hr.work.entry.type">
            <field name="name">Attendance Sheet Weekend</field>
            <field name="code">ATTSHWE</field>
            <field name="color">3</field>
            <field name="is_leave">False</field>
            <field name="round_days">HALF</field>
            <field name="round_days_type">DOWN</field>
        </record>
        
        <record id="work_entry_type_attendance_sheet_public_holiday"
                model="hr.work.entry.type">
            <field name="name">Attendance Sheet Public Holiday</field>
            <field name="code">ATTSHPH</field>
            <field name="color">3</field>
            <field name="is_leave">False</field>
            <field name="round_days">HALF</field>
            <field name="round_days_type">DOWN</field>
        </record>

    </data>

</odoo>